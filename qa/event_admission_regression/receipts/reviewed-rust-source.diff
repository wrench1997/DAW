+                velocity: 0
+            }),
+            Err(Error::EventInputRejected)
+        ));
+        assert!(matches!(
+            plugin.midi_panic(),
+            Err(Error::EventInputRejected)
+        ));
+    });
+    assert_eq!(plugin.runtime.active_notes, [(7, 0, 60)]);
+    assert_eq!(plugin.runtime.next_note_id, 8);
