+        | PluginEventData::NoteOff { .. }
+        | PluginEventData::PolyPressure { .. }
+        | PluginEventData::NoteExpressionValue { .. }
+        | PluginEventData::NoteExpressionIntValue { .. }
+        | PluginEventData::LegacyMidiCcOut { .. } => Ok(0),
+    }
