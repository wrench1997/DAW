+fn process_and_assert_samples(plugin: &mut PluginImpl, buses: usize, channels: usize) {
+    let mut buffers = AudioBuffers::new(0, buses * channels, 16, 48000.0);
+    plugin.process(&mut buffers).unwrap();
+    for bus in 0..buses {
+        for channel in 0..channels {
+            assert_eq!(
+                buffers.outputs[bus * channels + channel],
+                vec![(bus * 10 + channel + 1) as f32; 16]
+            );
+        }
+    }
+}
