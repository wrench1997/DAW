+        for capacity in [32, 128, 512, 8192] {
+            let changes = ParameterChanges::new(limits(8, capacity));
+            let mut oracle: Vec<(usize, i32, f64)> = Vec::with_capacity(capacity);
+            allocation_free(|| unsafe {
+                for round in 0..2 {
+                    changes.clear_all().unwrap();
