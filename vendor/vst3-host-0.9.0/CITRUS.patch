+struct ReleaseOnDrop(Option<mpsc::SyncSender<()>>);
+impl Drop for ReleaseOnDrop {
+    fn drop(&mut self) {
+        if let Some(sender) = self.0.take() {
+            let _ = sender.send(());
+        }
+    }
