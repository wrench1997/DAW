+    if result != kResultOk
+        && result != kResultTrue
+        && !(allow_not_implemented && result == kNotImplemented)
+    {
+        return Err(Error::Other(format!("Failed to {operation}: {result:#x}")));
+    }
+    *state = false;
+    Ok(())
