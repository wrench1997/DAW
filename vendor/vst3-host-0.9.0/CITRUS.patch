+    assert!(workers.iter().all(|id| *id == workers[0]));
+    assert!(trace.methods()[before..]
+        .iter()
+        .all(|(_, method)| *method == "process"));
+    assert!(owner.is_processing());
+    drop(owner);
+    assert_owner_ledger(&trace, main, &[workers[0]]);
+    assert_teardown_before_module(&trace);
+}
