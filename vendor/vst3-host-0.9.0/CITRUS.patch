+pub(super) struct DataExchangeProcessGuard<'gate> {
+    in_process: &'gate AtomicBool,
+    _not_send_sync: PhantomData<Rc<()>>,
+}
+
+impl Drop for DataExchangeProcessGuard<'_> {
+    fn drop(&mut self) {
+        self.in_process.store(false, Ordering::Release);
+    }
