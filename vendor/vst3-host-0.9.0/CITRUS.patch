+/// Check each SDK pointer against the owning host vectors, rather than requiring allocator
+/// addresses to differ across rebuilds (an allocator may legitimately reuse an address).
+fn assert_prepared_layout(plugin: &PluginImpl, buses: usize, channels: usize) {
+    let data = plugin
+        .runtime
+        .process_data
+        .as_ref()
+        .expect("prepared process data");
+    assert_eq!(data.process_data.numOutputs as usize, buses);
+    assert_eq!(data.output_bus_buffers.len(), buses);
+    assert_eq!(
+        data.process_data.outputs as *const AudioBusBuffers,
+        data.output_bus_buffers.as_ptr()
+    );
+    let HostSampleBuffers::F32(samples) = &data.sample_buffers else {
+        panic!("expected f32 fixture");
+    };
+    assert_eq!(samples.outputs.len(), buses * channels);
+    for (index, bus) in data.output_bus_buffers.iter().enumerate() {
+        assert_eq!(bus.numChannels as usize, channels);
+        let pointers = &samples.output_channel_ptrs.0[index];
+        assert_eq!(pointers.len(), channels);
+        assert_eq!(
+            unsafe { bus.__field0.channelBuffers32 } as *const *mut f32,
+            pointers.as_ptr()
+        );
+        for (channel, pointer) in pointers.iter().enumerate() {
+            assert_eq!(
+                *pointer as *const f32,
+                samples.outputs[index * channels + channel].as_ptr()
+            );
+        }
+    }
+    assert_eq!(plugin.output_channel_count(), buses * channels);
+}
