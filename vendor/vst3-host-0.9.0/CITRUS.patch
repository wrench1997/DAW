+        CheckedAudioBusConfig {
+            channel_count: 2,
+            is_main: true,
+            active: Some(true)
+        };
+        33
+    ];
+    let source = HostResponse::StrictMetadataSnapshot {
+        snapshot: crate::process_isolation::StrictMetadataSnapshot {
+            audio: CheckedAudioBusLayout {
+                inputs: Vec::new(),
+                outputs: buses,
+            },
+            events: EventBusLayout {
+                inputs: Vec::new(),
+                outputs: Vec::new(),
+            },
+            latency_samples: 0,
+            tail_samples: 0,
+        },
+    };
+    error(
+        &wire(&source),
+        &ReplyShape::StrictMetadataSnapshot,
+        ErrorKind::Limit,
+    );
+}
+
+#[test]
+fn selected_bundle_codec_known_failure_keeps_actual_getter_when_copy_fails() {
+    for getter in [
+        MetadataGetter::CheckedAudioBusLayout,
+        MetadataGetter::EventBusLayout,
+        MetadataGetter::LatencySamples,
+        MetadataGetter::TailSamples,
+    ] {
+        let source = HostResponse::StrictMetadataFailed {
+            getter,
+            message: "actual failure".into(),
+        };
+        let bytes = wire(&source);
+        let mut budget = new_budget();
+        let marker =
+            allocation_free(|| preflight(&bytes, &ReplyShape::StrictMetadataSnapshot, &mut budget))
+                .unwrap()
+                .unwrap();
+        budget.cancel.cancelled.store(true, Ordering::Release);
+        let _hook = budget_test_hooks::fail_next_allocation();
+        assert!(
+            matches!(marker.materialize(&mut budget), DecodedReply::KnownFailure { crashed: false, reported: None, diagnostic_unavailable: Some(ErrorKind::Allocation), metadata_getter: Some(actual) } if actual == getter)
+        );
+    }
+}
+
+#[test]
+fn selected_bundle_codec_snapshot_stop_fences_cover_both_passes() {
+    let bytes = wire(&HostResponse::StrictMetadataSnapshot {
+        snapshot: crate::process_isolation::StrictMetadataSnapshot {
+            audio: CheckedAudioBusLayout {
+                inputs: Vec::new(),
+                outputs: vec![
+                    CheckedAudioBusConfig {
+                        channel_count: 2,
+                        is_main: true,
+                        active: Some(true)
+                    };
+                    32
+                ],
+            },
+            events: EventBusLayout {
+                inputs: vec![EventBusConfig {
+                    channel_count: 16,
+                    is_main: true,
+                    active: Some(true),
+                }],
+                outputs: Vec::new(),
+            },
+            latency_samples: 0,
+            tail_samples: u32::MAX,
+        },
+    });
+    let checks = {
+        let _hook = budget_test_hooks::cancel_at_check(usize::MAX);
+        decode(
+            &bytes,
+            &ReplyShape::StrictMetadataSnapshot,
+            &mut new_budget(),
+        )
+        .unwrap();
+        budget_test_hooks::checks()
+    };
+    for at in [2, checks / 2, checks] {
+        let _hook = budget_test_hooks::cancel_at_check(at);
+        assert_eq!(
+            decode(
+                &bytes,
+                &ReplyShape::StrictMetadataSnapshot,
+                &mut new_budget()
+            )
+            .unwrap_err(),
+            ErrorKind::Cancelled
+        );
+    }
+    let _hook = budget_test_hooks::fail_next_allocation();
+    assert_eq!(
+        decode(
+            &bytes,
+            &ReplyShape::StrictMetadataSnapshot,
+            &mut new_budget()
+        )
+        .unwrap_err(),
+        ErrorKind::Allocation
+    );
+}
+
+// Construct raw JSON rather than serde maps so duplicate and escaped keys
+// reach the actual closed parser without being coalesced by a fixture.
+fn selected_bundle_invalid_failure_schema_matrix() -> Vec<String> {
+    fn object(variant: &str, fields: &[(&str, &str)]) -> String {
+        let body = fields
+            .iter()
+            .map(|(key, value)| format!(r#""{key}":{value}"#))
+            .collect::<Vec<_>>()
+            .join(",");
+        format!(r#"{{"{variant}":{{{body}}}}}"#)
+    }
+    let mut wires = Vec::new();
+    for (variant, key, escaped, value, sibling) in [
+        (
+            "StrictMetadataFailed",
+            "getter",
+            r"\u0067etter",
+            r#""TailSamples""#,
+            Some(("message", r#""actual failure""#)),
+        ),
+        (
+            "StrictMetadataFailed",
+            "message",
+            r"\u006dessage",
+            r#""actual failure""#,
+            Some(("getter", r#""TailSamples""#)),
+        ),
+        (
+            "StrictMetadataRejected",
+            "getter",
+            r"\u0067etter",
+            r#""EventBusLayout""#,
+            Some(("reason", r#""Unsupported""#)),
+        ),
+        (
+            "StrictMetadataRejected",
+            "reason",
+            r"\u0072eason",
+            r#""Unsupported""#,
+            Some(("getter", r#""EventBusLayout""#)),
+        ),
+        (
+            "StrictMetadataAdmissionRejected",
+            "stage",
+            r"\u0073tage",
+            r#""EventInput""#,
+            None,
+        ),
+    ] {
+        let prefix: Vec<_> = sibling.into_iter().collect();
+        wires.push(object(variant, &prefix)); // required field missing
+        for (first, second) in [
+            (key, key),
+            (key, escaped),
+            (escaped, key),
+            (escaped, escaped),
+        ] {
+            let mut fields = prefix.clone();
+            fields.extend([(first, value), (second, value)]);
+            wires.push(object(variant, &fields));
+        }
+        for wrong in ["null", "0", "true", "{}", "[]"] {
+            let mut fields = prefix.clone();
+            fields.push((key, wrong));
+            wires.push(object(variant, &fields));
+        }
+        let mut fields = prefix;
+        fields.extend([(key, value), ("unexpected", "0")]);
+        wires.push(object(variant, &fields));
+    }
+    wires.extend([
+        r#"{"StrictMetadataFailed":{"getter":"unknown","message":"actual failure"}}"#.to_owned(),
+        r#"{"StrictMetadataRejected":{"getter":"unknown","reason":"Unsupported"}}"#.to_owned(),
+        r#"{"StrictMetadataRejected":{"getter":"EventBusLayout","reason":"unknown"}}"#.to_owned(),
+        r#"{"StrictMetadataAdmissionRejected":{"stage":"unknown"}}"#.to_owned(),
+    ]);
+    assert_eq!(wires.len(), 59);
+    wires
+}
+
+#[test]
+fn selected_bundle_codec_failure_field_matrix_has_no_validated_inner_attribution() {
+    for wire in selected_bundle_invalid_failure_schema_matrix() {
+        let mut budget = new_budget();
+        budget.reserve(17).unwrap();
+        // A partially parsed getter is never a KnownOperationFailure marker.
+        assert!(
+            matches!(
+                preflight(
+                    wire.as_bytes(),
+                    &ReplyShape::StrictMetadataSnapshot,
+                    &mut budget
+                ),
+                Err(ErrorKind::MalformedReply)
+            ),
+            "{wire}"
+        );
+        assert_eq!(budget.live, 17);
+        match super::decode(
+            wire.as_bytes(),
+            &ReplyShape::StrictMetadataSnapshot,
+            &mut budget,
+        ) {
+            Err(cause) => assert_eq!(cause, ErrorKind::MalformedReply, "{wire}"),
+            Ok(_) => panic!("malformed failure produced response or attribution: {wire}"),
+        }
+        assert_eq!(budget.live, 17);
+    }
+}
+
+#[test]
+fn selected_bundle_codec_unique_escaped_failure_fields_remain_valid() {
+    for wire in [
+        r#"{"StrictMetadataFailed":{"\u0067etter":"Tail\u0053amples","\u006dessage":"actual failure"}}"#,
+        r#"{"StrictMetadataRejected":{"\u0067etter":"EventBusLayout","\u0072eason":"Unsupported"}}"#,
+        r#"{"StrictMetadataAdmissionRejected":{"\u0073tage":"EventInput"}}"#,
+    ] {
+        assert!(
+            decode(
+                wire.as_bytes(),
+                &ReplyShape::StrictMetadataSnapshot,
+                &mut new_budget()
+            )
+            .is_ok(),
+            "{wire}"
+        );
+    }
+}
diff --git a/src/fresh_helper/lifecycle.rs b/src/fresh_helper/lifecycle.rs
new file mode 100644
--- /dev/null
+++ b/src/fresh_helper/lifecycle.rs
@@ -0,0 +1,112 @@
+//! Shared retained-child teardown: pipe completion and concrete reap are both required.
+
+use super::{pump, ChildOwner, CleanupState, ErrorKind};
+use std::time::Instant;
+
+/// Preserve the direct-child status even if a descendant keeps its pipe open.
+pub(super) fn observe_child(owner: &mut ChildOwner) -> Result<bool, ErrorKind> {
+    if owner.observed_exit.is_some() {
+        return Ok(true);
+    }
+    match owner.child.try_wait() {
+        Ok(Some(status)) => {
+            owner.observed_exit = Some(status);
+            Ok(true)
+        }
+        Ok(None) => Ok(false),
+        Err(error) => Err(pump::io_error(error)),
+    }
+}
+
+/// Returns whether observation may continue. All evidence is kept on the same
+/// child even if a subsequent Rust test hook unwinds or Drop quarantines it.
+fn cleanup_observation(
+    owner: &mut ChildOwner,
+    graceful_until: Option<Instant>,
+    kill_deadline: Option<Instant>,
+) -> bool {
+    let pipes_closed = pump::close_pipes(owner);
+    owner.cleanup_report.kill_requested = owner.kill_requested;
+    if let Some(status) = owner.observed_exit {
+        if pipes_closed {
+            owner.cleanup_report.state = CleanupState::Reaped(status);
+            return false;
+        }
+        return true;
+    }
+    #[cfg(test)]
+    if pump::test_hooks::take(pump::test_hooks::Fault::ReapPanic) {
+        panic!("Rust cleanup observation hook");
+    }
+    #[cfg(test)]
+    if pump::test_hooks::take(pump::test_hooks::Fault::Wait) {
+        owner.cleanup_report.wait_error.get_or_insert(libc::EIO);
+        return false;
+    }
+    match owner.child.try_wait() {
+        Ok(Some(status)) => {
+            owner.observed_exit = Some(status);
+            if pipes_closed {
+                owner.cleanup_report.state = CleanupState::Reaped(status);
+                return false;
+            }
+            return true;
+        }
+        Ok(None) => {}
+        Err(error) => {
+            owner
+                .cleanup_report
+                .wait_error
+                .get_or_insert(error.raw_os_error().unwrap_or(libc::EIO));
+            return false;
+        }
+    }
+    if !owner.kill_requested
+        && kill_deadline.is_none_or(|limit| Instant::now() < limit)
+        && graceful_until.is_none_or(|until| Instant::now() >= until)
+    {
+        #[cfg(test)]
+        if pump::test_hooks::take(pump::test_hooks::Fault::Kill) {
+            owner.cleanup_report.kill_error.get_or_insert(libc::EPERM);
+            return false;
+        }
+        match owner.child.kill() {
+            Ok(()) => {
+                owner.kill_requested = true;
+                owner.cleanup_report.kill_requested = true;
+            }
+            Err(error) => {
+                owner
+                    .cleanup_report
+                    .kill_error
+                    .get_or_insert(error.raw_os_error().unwrap_or(libc::EIO));
+                return false;
+            }
+        }
+    }
+    true
+}
+
+/// One observation and at most one eligible kill. A kill is never a reap result.
+pub(super) fn reap_once(owner: &mut ChildOwner, graceful_until: Option<Instant>) {
+    cleanup_observation(owner, graceful_until, None);
+}
+
+pub(super) fn reap(owner: &mut ChildOwner, deadline: Instant, graceful_until: Option<Instant>) {
+    loop {
+        if !cleanup_observation(owner, graceful_until, Some(deadline)) || Instant::now() >= deadline
+        {
+            return;
+        }
+        // Original deadline only; no background reaper or blocking Child::wait.
+        #[cfg(test)]
+        if owner.kill_requested && pump::test_hooks::take(pump::test_hooks::Fault::PollAfterKill) {
+            owner.cleanup_report.wait_error.get_or_insert(libc::EIO);
+            return;
+        }
+        if let Err(ErrorKind::Io(code)) = pump::wait_cleanup(owner, deadline) {
+            owner.cleanup_report.wait_error.get_or_insert(code);
+            return;
+        }
+    }
+}
