+fn queued_note_releases(plugin: &PluginImpl) -> Vec<(i32, i16, i16)> {
+    plugin
+        .runtime
+        .input_events
+        .events
+        .lock()
+        .unwrap()
+        .iter()
+        .filter_map(|event| match event.data {
+            crate::midi::PluginEventData::NoteOff {
+                note_id,
+                channel,
+                pitch,
+                ..
+            } => Some((note_id, channel, pitch)),
+            _ => None,
+        })
+        .collect()
+}
