+    for target in [
+        ("component", "terminate"),
+        ("component", "drop"),
+        ("factory", "drop"),
+    ] {
+        assert_eq!(calls.iter().filter(|call| **call == target).count(), 1);
+        assert!(calls.iter().position(|call| *call == target).unwrap() < module);
