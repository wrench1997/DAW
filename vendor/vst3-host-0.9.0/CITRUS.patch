+        internal: Some(Box::new(internal)),
+    };
+    let owner = crate::plugin::MainThreadPlugin::from_in_process(plugin);
+    trace.clear();
+    drop(owner);
+    let calls = trace.methods();
+    let position = |target| calls.iter().position(|call| *call == target).unwrap();
+    assert!(
+        position(("component", "setProcessing(false)"))
+            < position(("component", "setActive(false)"))
+    );
+    assert!(position(("component", "setActive(false)")) < position(("component", "terminate")));
+    assert!(position(("component", "terminate")) < position(("component", "drop")));
+    assert!(position(("component", "drop")) < position(("module", "drop")));
+    assert!(position(("factory", "drop")) < position(("module", "drop")));
+    assert_eq!(trace.lifecycle(), [("component", "terminate")]);
+    trace.assert_thread(thread::current().id());
+}
