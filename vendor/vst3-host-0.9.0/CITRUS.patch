+impl<const S: bool, const C: bool> IAudioProcessorTrait for MockPlugin<S, C> {
+    unsafe fn setBusArrangements(
+        &self,
+        _inputs: *mut SpeakerArrangement,
+        _num_inputs: i32,
+        _outputs: *mut SpeakerArrangement,
+        _num_outputs: i32,
+    ) -> tresult {
+        self.probe.record("setBusArrangements");
+        if self.state.change_on_refusal.load(Ordering::Relaxed) {
+            self.state.channels.store(2, Ordering::Relaxed);
+            kResultFalse
+        } else {
+            kResultOk
+        }
+    }
+    unsafe fn getBusArrangement(
+        &self,
+        direction: BusDirection,
+        index: i32,
+        arrangement: *mut SpeakerArrangement,
+    ) -> tresult {
+        self.probe.record("getBusArrangement");
+        if direction != kOutput as i32
+            || index < 0
+            || index >= self.state.output_buses.load(Ordering::Relaxed)
+        {
+            return kInvalidArgument;
+        }
+        *arrangement = if self.state.channels.load(Ordering::Relaxed) == 1 {
+            SpeakerArr::kMono
+        } else {
+            SpeakerArr::kStereo
+        };
+        kResultOk
+    }
+    unsafe fn canProcessSampleSize(&self, size: i32) -> tresult {
+        if size == SymbolicSampleSizes_::kSample32 as i32 {
+            kResultOk
+        } else {
+            kResultFalse
+        }
+    }
+    unsafe fn getLatencySamples(&self) -> u32 {
+        0
+    }
+    unsafe fn setupProcessing(&self, _setup: *mut ProcessSetup) -> tresult {
+        self.probe.record("setupProcessing");
+        if self.state.fail_setup.load(Ordering::Relaxed) {
+            kResultFalse
+        } else {
+            kResultOk
+        }
+    }
+    unsafe fn setProcessing(&self, state: TBool) -> tresult {
+        self.probe.record(if state == 0 {
+            "setProcessing(false)"
+        } else {
+            "setProcessing(true)"
+        });
+        kResultOk
+    }
+    unsafe fn process(&self, data: *mut ProcessData) -> tresult {
+        self.probe.record("process");
+        if self.state.fail_process.load(Ordering::Acquire) {
+            return kResultFalse;
+        }
+        let data = &mut *data;
+        let mut parameters = Vec::new();
+        if let Some(changes) = vst3::ComRef::from_raw(data.inputParameterChanges) {
+            for index in 0..changes.getParameterCount() {
+                let queue = vst3::ComRef::from_raw(changes.getParameterData(index)).unwrap();
+                for point in 0..queue.getPointCount() {
+                    let (mut offset, mut value) = (0, 0.0);
+                    assert_eq!(queue.getPoint(point, &mut offset, &mut value), kResultOk);
+                    parameters.push((queue.getParameterId(), offset, value));
+                }
+            }
+        }
+        self.state
+            .processed_parameters
+            .lock()
+            .unwrap()
+            .push(parameters);
+        if let Some(callback) = self.state.process_callback.lock().unwrap().as_ref() {
+            callback();
+        }
+        let mut layout = Vec::new();
+        for index in 0..data.numOutputs.max(0) as usize {
+            let bus = &mut *data.outputs.add(index);
+            layout.push(bus.numChannels);
+            for channel in 0..bus.numChannels.max(0) as usize {
+                let samples = *bus.__field0.channelBuffers32.add(channel);
+                // Inactive buses have null channel pointers. Their slot must still survive.
+                if !samples.is_null() {
+                    for sample in 0..data.numSamples.max(0) as usize {
+                        *samples.add(sample) = (index * 10 + channel + 1) as f32;
+                    }
+                }
+            }
+            bus.silenceFlags = 0;
+        }
+        self.state.processed_layouts.lock().unwrap().push(layout);
+        kResultOk
+    }
+    unsafe fn getTailSamples(&self) -> u32 {
+        0
+    }
+}
