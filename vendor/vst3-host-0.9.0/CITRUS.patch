+                .try_add_raw_event(&ev)
+                .map_err(|_| Error::EventInputRejected)?;
+        }
+        self.next_note_id = id.wrapping_add(1).max(1);
+        self.active_notes
+            .push((id, channel.as_index() as i16, note as i16));
