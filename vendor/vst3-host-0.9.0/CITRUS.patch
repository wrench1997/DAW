+//! Synchronous ownership/lifecycle regression tests using real VST3 COM interfaces.
+//! These mocks intentionally allocate and lock; these are not real-time-safety tests.
+
+#![allow(non_snake_case)]
+#![allow(clippy::unnecessary_cast)] // SDK enum types vary across platforms.
+
+use super::*;
+use std::{
+    ffi::c_void,
+    mem::offset_of,
+    sync::atomic::{AtomicBool, AtomicI32, AtomicUsize, Ordering},
+};
+use vst3::{
+    com_scrape_types::{Header, InterfaceList, MakeHeader, Wrapper},
+    Class,
+};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Call {
+    object: &'static str,
+    method: &'static str,
+    thread: ThreadId,
+}
+
+#[derive(Clone, Default)]
+struct Trace(Arc<Mutex<Vec<Call>>>);
+
+impl Trace {
+    fn record(&self, object: &'static str, method: &'static str) {
+        self.0.lock().unwrap().push(Call {
+            object,
+            method,
+            thread: thread::current().id(),
+        });
+    }
+
+    fn calls(&self) -> Vec<Call> {
+        self.0.lock().unwrap().clone()
+    }
+
+    fn clear(&self) {
+        self.0.lock().unwrap().clear();
+    }
+
+    fn methods(&self) -> Vec<(&'static str, &'static str)> {
+        self.calls().iter().map(|c| (c.object, c.method)).collect()
+    }
+
+    fn lifecycle(&self) -> Vec<(&'static str, &'static str)> {
+        self.methods()
+            .into_iter()
+            .filter(|(_, method)| matches!(*method, "initialize" | "terminate"))
+            .collect()
+    }
+
+    fn assert_thread(&self, expected: ThreadId) {
+        let calls = self.calls();
+        assert!(!calls.is_empty());
+        for call in calls {
+            assert_eq!(call.thread, expected, "wrong thread for {call:?}");
+        }
+    }
+}
+
+struct Probe {
+    name: &'static str,
+    trace: Trace,
+}
+
+impl Probe {
+    fn record(&self, method: &'static str) {
+        self.trace.record(self.name, method);
+    }
+}
+
+trait Recorded {
+    fn probe(&self) -> &Probe;
+}
+
+// The generated COM vtables delegate their actual addRef/release operations here. Unlike
+// checking final Drop alone, this detects even a balanced clone/drop inside a short lease.
+#[repr(C)]
+struct TrackedObject<C: Class> {
+    header: Header<C>,
+    references: AtomicUsize,
+    value: C,
+}
+
+struct TrackedCom;
+
+impl<C: Class + Recorded> Wrapper<C> for TrackedCom {
+    unsafe fn data_from_header(header: *mut Header<C>) -> *mut C {
+        // repr(C), with header first: every interface offset is generated by MakeHeader.
+        ptr::addr_of_mut!((*(header.cast::<TrackedObject<C>>())).value)
+    }
+
+    unsafe fn header_from_data(value: *mut C) -> *mut Header<C> {
+        value
+            .cast::<u8>()
+            .sub(offset_of!(TrackedObject<C>, value))
+            .cast()
+    }
+
+    unsafe fn add_ref(value: *mut C) -> usize {
+        let object = Self::header_from_data(value).cast::<TrackedObject<C>>();
+        (*value).probe().record("addRef");
+        (*object).references.fetch_add(1, Ordering::Relaxed) + 1
+    }
+
+    unsafe fn release(value: *mut C) -> usize {
+        let object = Self::header_from_data(value).cast::<TrackedObject<C>>();
+        (*value).probe().record("release");
+        let remaining = (*object).references.fetch_sub(1, Ordering::AcqRel) - 1;
+        if remaining == 0 {
+            drop(Box::from_raw(object));
+        }
+        remaining
+    }
+}
+
+fn tracked<C, I>(value: C) -> ComPtr<I>
+where
+    C: Class + Recorded + Send + Sync + 'static,
+    C::Interfaces: MakeHeader<C, TrackedCom>,
+    I: Interface,
+{
+    let offset = C::Interfaces::query(&I::IID).expect("mock must expose requested interface");
+    let object = Box::new(TrackedObject {
+        header: <C::Interfaces as MakeHeader<C, TrackedCom>>::HEADER,
+        references: AtomicUsize::new(1),
+        value,
+    });
+    // Transfer the allocation's initial owning reference to ComPtr; no hidden wrapper owner.
+    unsafe {
+        let interface = Box::into_raw(object)
+            .cast::<u8>()
+            .offset(offset)
+            .cast::<I>();
+        ComPtr::from_raw(interface).unwrap()
+    }
+}
