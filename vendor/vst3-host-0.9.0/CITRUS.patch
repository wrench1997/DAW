+                    .component_handler
+                    .as_ref()
+                    .unwrap()
+                    .pending_restart_flags()
+                    .bits(),
+                flag
+            );
+            if !reentrant {
+                assert!(trace.methods().is_empty());
+            }
+            *state.bus_info_callback.lock().unwrap() = None;
+        }
