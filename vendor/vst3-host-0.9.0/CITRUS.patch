+fn transferred_initialization_guard_releases_before_later_load_failure_unloads_module() {
+    let trace = Trace::default();
+    let state = Arc::new(MockState::default());
+    // Match loader declaration order: guard predates the completed plugin owner.
+    let mut initialized;
+    let mut plugin = plugin_fixture(&trace, &state);
+    initialized = InitializedComponent::new(plugin.control.component.clone());
+    initialized.attach_controller(plugin.control.controller.clone(), true);
+    trace.clear();
+    initialized.finish_transfer();
+    assert_eq!(
+        trace.methods(),
+        [("component", "release"), ("component", "release")]
+    );
+    // A subsequent fallible post-transfer operation fails, triggering ordinary owner Drop.
+    state.fail_setup.store(true, Ordering::Relaxed);
+    assert!(plugin.setup_processing().is_err());
+    drop(plugin);
+    let calls = trace.methods();
+    let module = calls
+        .iter()
+        .position(|call| *call == ("module", "drop"))
+        .unwrap();
+    assert!(!calls[module + 1..]
+        .iter()
+        .any(|(_, method)| *method == "release"));
+    assert!(calls[..module].contains(&("component", "drop")));
+    assert!(calls[..module].contains(&("factory", "drop")));
+    assert_eq!(trace.lifecycle(), [("component", "terminate")]);
+}
