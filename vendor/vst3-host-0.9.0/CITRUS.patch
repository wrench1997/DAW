+        assert!(
+            preflight(&bytes, &ReplyShape::FactoryMetadata, &mut new_budget())
+                .unwrap()
+                .is_none()
+        );
+        budget_test_hooks::checks()
+    };
+    let all_checks = {
+        let _hook = budget_test_hooks::cancel_at_check(usize::MAX);
+        decode(&bytes, &ReplyShape::FactoryMetadata, &mut new_budget()).unwrap();
+        budget_test_hooks::checks()
+    };
