+                unique(&mut seen, 4)?;
+                version = self.text(MAX_TEXT)?;
+            } else if key.is(b"category") {
+                unique(&mut seen, 8)?;
+                category = self.text(MAX_TEXT)?;
+            } else if key.is(b"uid") {
