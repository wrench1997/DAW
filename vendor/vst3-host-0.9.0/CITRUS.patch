+
+    fn take_output_events_with_loss(&self) -> (Vec<PluginEvent>, bool) {
+        let events = self.take_output_events();
+        let lost = self
+            .output_events_lost
+            .swap(false, std::sync::atomic::Ordering::AcqRel);
