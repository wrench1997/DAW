+    for mode in [
+        "inactive",
+        "not_processing",
+        "output_fault",
+        "wrong_thread",
+        "missing_setup",
+        "missing_data",
+        "active_call",
+    ] {
+        let trace = Trace::default();
+        let mut owner = plugin_fixture(&trace, &Arc::new(MockState::default()));
+        owner.start_processing().unwrap();
