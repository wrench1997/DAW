+
+fn stop_processor_notification(
+    state: &mut bool,
+    processor: &mut impl ProcessorCalls,
+) -> Result<()> {
+    if *state {
+        let result = processor.set_processing(0);
+        finish_stop_transition(state, result, true, "stop processing")?;
+    }
+    Ok(())
+}
